{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 2 -X POST -H 'Content-Type: application/json' -d '{\"respect_mute\":true}' \"$(pairvoice url)/api/warmup\" >/dev/null 2>&1 || true",
            "async": true
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/speak-summary.sh\""
          }
        ]
      }
    ]
  }
}
