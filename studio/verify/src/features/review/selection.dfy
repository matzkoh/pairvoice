// Generated by lsc from selection.ts
// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

function SeqIndexOf<T(==)>(s: seq<T>, x: T): int
  ensures -1 <= SeqIndexOf(s, x) < |s|
  ensures SeqIndexOf(s, x) >= 0 ==> s[SeqIndexOf(s, x)] == x
  ensures SeqIndexOf(s, x) == -1 ==> x !in s
{
  SeqIndexOfFrom(s, x, 0)
}

function SeqIndexOfFrom<T(==)>(s: seq<T>, x: T, from: nat): int
  requires from <= |s|
  ensures -1 <= SeqIndexOfFrom(s, x, from) < |s|
  ensures SeqIndexOfFrom(s, x, from) >= 0 ==> s[SeqIndexOfFrom(s, x, from)] == x
  ensures SeqIndexOfFrom(s, x, from) == -1 ==> forall i :: from <= i < |s| ==> s[i] != x
  decreases |s| - from
{
  if from == |s| then -1
  else if s[from] == x then from as int
  else SeqIndexOfFrom(s, x, from + 1)
}

function SeqFilter<T(!new)>(p: T -> bool, xs: seq<T>): seq<T>
  ensures |SeqFilter(p, xs)| <= |xs|
  ensures forall x :: x in SeqFilter(p, xs) <==> x in xs && p(x)
  ensures forall i :: 0 <= i < |SeqFilter(p, xs)| ==> SeqFilter(p, xs)[i] in xs
  decreases |xs|
{
  if |xs| == 0 then []
  else (if p(xs[0]) then [xs[0]] else []) + SeqFilter(p, xs[1..])
}

function MathMin(a: int, b: int): int { if a <= b then a else b }

function MathMax(a: int, b: int): int { if a >= b then a else b }

function nextSelection(ids: seq<string>, current: Option<string>, delta: int): Option<string>
  requires ((delta == 1) || (delta == -1))
{
  if (|ids| == 0) then
    None
  else
    var index := (match current { case Some(i_current_val) => SeqIndexOf(ids, i_current_val) case None => -1 });
    if (index == -1) then
      Some((if (delta == 1) then ids[0] else ids[(|ids| - 1)]))
    else
      Some(ids[MathMin((|ids| - 1), MathMax(0, (index + delta)))])
}

lemma nextSelection_ensures(ids: seq<string>, current: Option<string>, delta: int)
  requires ((delta == 1) || (delta == -1))
  ensures ((|ids| == 0) <==> (match nextSelection(ids, current, delta) { case Some(i_) => false case None => true }))
  ensures (match nextSelection(ids, current, delta) { case Some(i_result_val) => (i_result_val in ids) case None => true })
  ensures ((|ids| > 0) ==> (match current { case Some(i_) => false case None => true }) ==> (match nextSelection(ids, current, delta) { case Some(i_value) => (i_value == (if (delta == 1) then ids[0] else ids[(|ids| - 1)])) case None => false }))
  ensures (match current { case Some(i_current_val) => ((|ids| > 0) ==> !((i_current_val in ids)) ==> (match nextSelection(ids, current, delta) { case Some(i_value) => (i_value == (if (delta == 1) then ids[0] else ids[(|ids| - 1)])) case None => false })) case None => true })
  ensures (match current { case Some(i_current_val) => ((i_current_val in ids) ==> (0 <= (SeqIndexOf(ids, i_current_val) + delta)) ==> ((SeqIndexOf(ids, i_current_val) + delta) < |ids|) ==> (match nextSelection(ids, current, delta) { case Some(i_value) => (i_value == ids[(SeqIndexOf(ids, i_current_val) + delta)]) case None => false })) case None => true })
  ensures (match current { case Some(i_current_val) => ((i_current_val in ids) ==> (((SeqIndexOf(ids, i_current_val) + delta) < 0) || ((SeqIndexOf(ids, i_current_val) + delta) >= |ids|)) ==> (match nextSelection(ids, current, delta) { case Some(i_value) => (i_value == i_current_val) case None => false })) case None => true })
{
}

function selectionAfterRemoval(ids: seq<string>, removedId: string): Option<string>
{
  var index := SeqIndexOf(ids, removedId);
  var rest := SeqFilter((id: string) => (id != removedId), ids);
  if (|rest| == 0) then
    None
  else
    if (index == -1) then
      Some(rest[0])
    else
      Some(rest[MathMin(index, (|rest| - 1))])
}

lemma selectionAfterRemoval_ensures(ids: seq<string>, removedId: string)
  ensures ((match selectionAfterRemoval(ids, removedId) { case Some(i_) => false case None => true }) <==> forall i: nat :: ((i < |ids|) ==> (ids[i] == removedId)))
  ensures (match selectionAfterRemoval(ids, removedId) { case Some(i_result_val) => ((i_result_val in ids) && (i_result_val != removedId)) case None => true })
  ensures ((|ids| >= 2) ==> (forall i: nat, j: nat :: ((i < |ids|) ==> (j < |ids|) ==> (i != j) ==> (ids[i] != ids[j]))) ==> (removedId in ids) ==> (SeqIndexOf(ids, removedId) < (|ids| - 1)) ==> (match selectionAfterRemoval(ids, removedId) { case Some(i_value) => (i_value == ids[(SeqIndexOf(ids, removedId) + 1)]) case None => false }))
  ensures ((|ids| >= 2) ==> (forall i: nat, j: nat :: ((i < |ids|) ==> (j < |ids|) ==> (i != j) ==> (ids[i] != ids[j]))) ==> (ids[(|ids| - 1)] == removedId) ==> (match selectionAfterRemoval(ids, removedId) { case Some(i_value) => (i_value == ids[(|ids| - 2)]) case None => false }))
{
  var rest := SeqFilter((id: string) => (id != removedId), ids);
  if |rest| == 0 {
    forall i: nat | i < |ids| ensures ids[i] == removedId {
      if ids[i] != removedId { assert ids[i] in rest; }
    }
  } else {
    assert rest[0] in rest;
  }
  if removedId in ids && forall i: nat, j: nat :: i < |ids| ==> j < |ids| ==> i != j ==> ids[i] != ids[j] {
    FilterRemovesOnly((id: string) => (id != removedId), ids, removedId, SeqIndexOf(ids, removedId));
  }
}

// 一意な列から r を除く filter は、r の位置だけを抜いた列になる
lemma FilterRemovesOnly(p: string -> bool, ids: seq<string>, r: string, k: nat)
  requires forall x :: p(x) <==> x != r
  requires k < |ids| && ids[k] == r
  requires forall i: nat, j: nat :: i < |ids| ==> j < |ids| ==> i != j ==> ids[i] != ids[j]
  ensures SeqFilter(p, ids) == ids[..k] + ids[k + 1..]
  decreases |ids|
{
  var tail := ids[1..];
  assert SeqFilter(p, ids) == (if p(ids[0]) then [ids[0]] else []) + SeqFilter(p, tail);
  if k == 0 {
    forall i: nat | i < |tail| ensures tail[i] != r {
      assert tail[i] == ids[i + 1];
    }
    FilterKeepsAll(p, tail, r);
  } else {
    assert ids[0] != r by { assert ids[0] == ids[0 as nat] && ids[k] == r; }
    forall i: nat, j: nat | i < |tail| && j < |tail| && i != j ensures tail[i] != tail[j] {
      assert tail[i] == ids[i + 1] && tail[j] == ids[j + 1];
    }
    FilterRemovesOnly(p, tail, r, k - 1);
    assert tail[..k - 1] == ids[1..k];
    assert tail[k..] == ids[k + 1..];
    assert ids[..k] == [ids[0]] + ids[1..k];
  }
}

lemma FilterKeepsAll(p: string -> bool, xs: seq<string>, r: string)
  requires forall x :: p(x) <==> x != r
  requires r !in xs
  ensures SeqFilter(p, xs) == xs
  decreases |xs|
{
  if |xs| > 0 {
    FilterKeepsAll(p, xs[1..], r);
    assert xs == [xs[0]] + xs[1..];
  }
}
