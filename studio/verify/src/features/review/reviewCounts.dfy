// Generated by lsc from reviewCounts.ts
// lsc options: string-semantics=javascript-utf16

datatype Option<T> = None | Some(value: T)

function SeqFilter<T(!new)>(p: T -> bool, xs: seq<T>): seq<T>
  ensures |SeqFilter(p, xs)| <= |xs|
  ensures forall x :: x in SeqFilter(p, xs) <==> x in xs && p(x)
  ensures forall i :: 0 <= i < |SeqFilter(p, xs)| ==> SeqFilter(p, xs)[i] in xs
  decreases |xs|
{
  if |xs| == 0 then []
  else (if p(xs[0]) then [xs[0]] else []) + SeqFilter(p, xs[1..])
}

function StringIndexOf(s: string, sub: string): int
  ensures StringIndexOf(s, sub) == -1
       || (0 <= StringIndexOf(s, sub) <= |s| - |sub| && s[StringIndexOf(s, sub)..StringIndexOf(s, sub) + |sub|] == sub)
{
  StringIndexOfFrom(s, sub, 0)
}

function StringIndexOfFrom(s: string, sub: string, from: int): int
  ensures StringIndexOfFrom(s, sub, from) == -1
       || (0 <= StringIndexOfFrom(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFrom(s, sub, from)..StringIndexOfFrom(s, sub, from) + |sub|] == sub
           && StringIndexOfFrom(s, sub, from) >= from)
{
  StringIndexOfFromN(s, sub, if from < 0 then 0 else from)
}

function StringIndexOfFromN(s: string, sub: string, from: nat): int
  decreases |s| - from
  ensures StringIndexOfFromN(s, sub, from) == -1
       || (from <= StringIndexOfFromN(s, sub, from) <= |s| - |sub|
           && s[StringIndexOfFromN(s, sub, from)..StringIndexOfFromN(s, sub, from) + |sub|] == sub)
{
  if from + |sub| > |s| then -1
  else if s[from..from + |sub|] == sub then from as int
  else StringIndexOfFromN(s, sub, from + 1)
}

datatype Filter = all | unreviewed | bad | archived | stale

datatype CorpusItem = CorpusItem(ts: string, message_id: string, input: string, summary: string, audio_path: Option<string>, voice: Option<string>, voice_name: Option<string>, style: Option<string>, summary_model: Option<string>, verdict: Option<SavedVerdict>, ideal: Option<string>, archived: bool, stale: bool)

datatype SavedVerdict = bad | good

function filterReviews(items: seq<CorpusItem>, filter: Filter, q: string): seq<CorpusItem>
{
  SeqFilter((r: CorpusItem) => (if (((q != "") && !((StringIndexOf(r.summary, q) >= 0))) && !((StringIndexOf(r.input, q) >= 0))) then false else (if filter.archived? then r.archived else (if r.archived then false else (if filter.stale? then r.stale else (if r.stale then false else (match r.verdict { case Some(i_r_verdict_val) => (if filter.unreviewed? then false else !((filter.bad? && (match r.verdict { case Some(i_value) => (!i_value.bad?) case None => true })))) case None => !((filter.bad? && (match r.verdict { case Some(i_value) => (!i_value.bad?) case None => true }))) })))))), items)
}

lemma filterReviews_ensures(items: seq<CorpusItem>, filter: Filter, q: string)
  ensures forall r: CorpusItem :: ((r in filterReviews(items, filter, q)) <==> (((r in items) && (((q == "") || (StringIndexOf(r.summary, q) >= 0)) || (StringIndexOf(r.input, q) >= 0))) && (if filter.archived? then r.archived else (!(r.archived) && (if filter.stale? then r.stale else ((!(r.stale) && ((!filter.unreviewed?) || (match r.verdict { case Some(i_) => false case None => true }))) && ((!filter.bad?) || (match r.verdict { case Some(i_value) => i_value.bad? case None => false }))))))))
{
}

function bulkArchiveTargets(items: seq<CorpusItem>): seq<CorpusItem>
{
  SeqFilter((r: CorpusItem) => (!(r.archived) && ((match r.verdict { case Some(i_value) => i_value.good? case None => false }) || (match r.verdict { case Some(i_value) => i_value.bad? case None => false }))), items)
}

lemma bulkArchiveTargets_ensures(items: seq<CorpusItem>)
  ensures forall r: CorpusItem :: ((r in bulkArchiveTargets(items)) <==> (((r in items) && !(r.archived)) && (match r.verdict { case Some(i_) => true case None => false })))
