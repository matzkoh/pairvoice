{
  "name": "pairvoice-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "PAIRVOICE_URL=$(uv run pairvoice url) vite",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "preview": "PAIRVOICE_URL=$(uv run pairvoice url) vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "5.106.0",
    "@tanstack/react-router": "1.170.46",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "packageManager": "pnpm@11.17.0"
}
